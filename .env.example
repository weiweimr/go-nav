# 运行模式:
#   未设置或 server -> Node.js 动态模式 (含 /admin 后台与 API 路由)
#   static         -> 纯静态导出 (无 /admin，无 API)
#   html           -> 静态导出到 web/，浏览器运行时读取 JSON 配置
# BUILD_MODE=server

# 后台管理账号
ADMIN_USER=admin
ADMIN_PASS=admin123

# Docker Compose 可选：宿主机映射端口，容器内固定为 3000
# PORT=3000

# 可选：站点正式域名，用于 canonical、Open Graph、robots.txt 与 sitemap.xml
# 静态部署强烈建议在 ESA 构建环境中配置，避免默认域名与实际域名不一致
# NEXT_PUBLIC_SITE_URL=https://nav.gotab.cn

# 可选：控制 data 目录配置文件写入格式（默认 json，可选 yaml）
# DATA_FILE_FORMAT=json

# 可选：自定义登录 session 密钥。
# Docker 不填会自动生成并持久化到数据目录；Compose 部署时还需要取消 docker-compose.yml 里的注释。
# SESSION_SECRET=change-this-to-a-long-random-string
